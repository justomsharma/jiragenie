# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# Your Jira workspace URL (e.g., https://yourcompany.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net

# The email associated with your Atlassian account
JIRA_EMAIL=you@example.com

# Atlassian API token — create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_atlassian_api_token_here

# Default Jira project key (e.g., "ENG", "PROD")
DEFAULT_PROJECT=ABC

# OpenAI API key — used for natural-language intent parsing
OPENAI_API_KEY=sk-...
